{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-docs",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8753"],
      "port": 8753
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "@ingame/api", "run", "dev:local"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "@ingame/mobile", "run", "web", "--", "--port", "8082"],
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "node",
      "runtimeArgs": ["../shipwright/dashboard/server.mjs", "--port", "8791"],
      "port": 8791
    }
  ]
}
