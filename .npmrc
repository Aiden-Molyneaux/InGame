# InGame npm config (committed). See docs/planning/m1-scaffold-task.md item 1 + decision 0051/F41.
# engine-strict keeps cold agents + CI on the pinned Node toolchain (.nvmrc / package.json "engines").
engine-strict=true
# Native/Expo deps must be added with `expo install` (never bare `npm i <native-pkg>`) so the
# Expo SDK / React Native / Reanimated / skia version matrix stays coherent (decision 0051/F41).
save-exact=false
fund=false
audit=false
