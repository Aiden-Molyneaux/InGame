# The admin console's env (Vite — only VITE_-prefixed vars reach the client bundle).
# Copy to `.env.local` to override. Both have safe defaults, so a bare `npm -w @ingame/admin run dev`
# works against the standing dev stack with no file at all.

# The API origin (NO /api suffix — the client appends it). Default: http://localhost:4000
VITE_API_URL=http://localhost:4000

# The Sentry dashboard to link out to (proposal §2 — "use Sentry, don't build it"). When unset the
# console hides the Errors card entirely rather than showing a dead link.
VITE_SENTRY_URL=
