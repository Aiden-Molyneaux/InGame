{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Standalone (NOT a `tsc -b` reference): the console emits nothing — Vite owns the build, tsc only typechecks. It therefore cannot extend tsconfig.base.json, whose `composite: true` forbids noEmit. The strictness flags below are copied from the base so the console is held to the same bar.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@ingame/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
