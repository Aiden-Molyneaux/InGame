# InGame API environment — documented template (SYS-03: env-only config, no hardcoded values).
# Copy to `.env.dev` for the local standing dev stack (decision 0060); real deployments inject
# these from the host secret store. `.env.dev` is gitignored.

# Postgres connection string. Local dev uses the `ingame-dev-db` docker container.
DATABASE_URL=postgres://ingame:ingame@localhost:5432/local_ingame

# F03 fail-closed sentinel — set to 1 ONLY on a disposable/dev database. Gates db:reset and
# db:seed-dev. Never set in production.
DISPOSABLE_DB=1

# API port (default 4000).
PORT=4000

# AUTH-02 — HS256 signing secret for access-token JWTs (min 16 chars). Server-only. For local dev
# any stable string works; keeping it stable across restarts keeps sessions valid.
JWT_SIGNING_SECRET=change-me-min-16-chars

# OQ-120 — dev-only CORS allowlist (comma-separated exact origins). Empty/unset = production
# posture: no CORS headers at all. Local dev sets the Expo-web Metro origin.
DEV_CORS_ORIGINS=http://localhost:8082

# Optional (defaults in src/config/env.ts): ACCESS_TOKEN_TTL_SECONDS, REFRESH_TOKEN_TTL_SECONDS,
# PASSWORD_RESET_TTL_SECONDS, EMAIL_VERIFY_TTL_SECONDS, USERNAME_COOLDOWN_SECONDS, SENTRY_DSN.
