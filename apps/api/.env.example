# InGame API environment — documented template (SYS-03: env-only config, no hardcoded values).
# Copy to `.env.dev` for the local standing dev stack (decision 0060); real deployments inject
# these from the host secret store. `.env.dev` is gitignored.

# Postgres connection string. Local dev uses the `ingame-dev-db` docker container.
DATABASE_URL=postgres://ingame:ingame@localhost:5432/local_ingame

# F03 fail-closed sentinel — set to 1 ONLY on a disposable/dev database. Gates db:reset and
# db:seed-dev. Never set in production.
DISPOSABLE_DB=1

# API port (default 4000).
PORT=4000

# AUTH-02 — HS256 signing secret for access-token JWTs (min 16 chars). Server-only. For local dev
# any stable string works; keeping it stable across restarts keeps sessions valid.
JWT_SIGNING_SECRET=change-me-min-16-chars

# OQ-120 — dev-only CORS allowlist (comma-separated exact origins). Empty/unset = production
# posture: no CORS headers at all. Local dev sets the Expo-web Metro origin.
DEV_CORS_ORIGINS=http://localhost:8082

# Optional (defaults in src/config/env.ts): ACCESS_TOKEN_TTL_SECONDS, REFRESH_TOKEN_TTL_SECONDS,
# PASSWORD_RESET_TTL_SECONDS, EMAIL_VERIFY_TTL_SECONDS, USERNAME_COOLDOWN_SECONDS, SENTRY_DSN.

# AUTH-01 (decision 0076 §0.9) — the SYS-04 kill-switch for the HIBP "Pwned Passwords" range-API
# breach check on register + password-reset confirm. Default ON; set to 'false' to skip the network
# call entirely (e.g. the provider is unreachable / rate-limiting us). The check is ALSO fail-open on
# its own (a timeout/5xx/network error never blocks register/reset) — this is the manual override on
# top of that. No new runtime dependency (plain fetch).
BREACH_CHECK_ENABLED=true

# SOC-10 (decision 0076 §0.6) — the base URL a minted invite token is appended to; POST /me/invites
# returns `${INVITE_LINK_BASE}/<token>`. The P15 static landing owns this route (tokenized URL →
# TestFlight while in beta; store-listing routing lands M8). Defaults to a placeholder in dev; production
# injects the real domain from the host secret store.
INVITE_LINK_BASE=https://ingame.app/i

# ── M6 transactional email (AUTH-12 · auth-epic P-A) ──────────────────────────────────────────────
# The email provider seam. 'stub' (the default OUTSIDE production) = log-only delivery + the in-memory
# dev/test outbox (the reset code lands in the local API log); 'resend' = the real HTTPS adapter (plain
# fetch, no SDK). PRODUCTION REFUSAL (F03, the IAP_PROVIDER pattern): with NODE_ENV=production the
# server REFUSES TO START when EMAIL_PROVIDER is 'stub' OR unset — a stub-emailing production process
# silently swallows every password reset.
EMAIL_PROVIDER=stub
# Resend API key — OWNER-provisioned (host secret store, NEVER the repo; SYS-03). Required when
# EMAIL_PROVIDER=resend; leave blank on the stub lane.
RESEND_API_KEY=
# The From header. Placeholder until the mail.ingame.app sending domain (SPF/DKIM) is provisioned —
# the owner sitting item paired with the P15 Cloudflare sitting.
EMAIL_FROM=InGame <no-reply@mail.ingame.app>

# ── M5 economy / IAP (RevenueCat) ─────────────────────────────────────────────────────────────────
# ECON-06/09. Server-only secrets; the client SDK key lives in apps/mobile/.env (EXPO_PUBLIC_,
# client-safe by design). Populate the real values in .env.dev (gitignored); leave blank here.
#
# The IAP provider seam (M5 P2). 'mock' (the default OUTSIDE production) = the deterministic
# MockRevenueCat (testing-strategy §5); 'revenuecat' = the real provider, wired at P2b when §6
# provisioning completes. Same IapProvider interface — the swap touches nothing else.
# PRODUCTION REFUSAL (M5 F-3, fail-closed): with NODE_ENV=production the server REFUSES TO START when
# IAP_PROVIDER is 'mock' OR unset — the mock validates any hand-built receipt (a forgeable free-Pixel
# faucet), and unset must fail loudly rather than silently mean mock. Production requires an explicit
# real provider value.
IAP_PROVIDER=mock
# RevenueCat REST secret API key (v2) — server→RevenueCat calls + entitlement re-sync. Consumed by the
# REAL provider at P2b ONLY (the mock needs no REST key); leave blank until then.
REVENUECAT_SECRET_API_KEY=
# RevenueCat webhook Authorization header value — the shared secret set on the RC webhook config,
# verified on POST /iap/webhook (the signature IS the webhook's auth). CONSUMED BY P2: the webhook
# endpoint verifies this against the incoming Authorization header (the mock compares it constant-time;
# the real RC posts this exact header value). Empty ⇒ the webhook fail-closes (rejects every call).
# For the standing dev stack, set any stable string in .env.dev. RC cannot reach localhost — a real
# end-to-end webhook needs a tunnel/deployed URL registered in the RC dashboard (P2b; see §6).
REVENUECAT_WEBHOOK_AUTH=
