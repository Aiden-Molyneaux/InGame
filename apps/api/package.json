{
  "name": "@ingame/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "InGame API \u00e2\u20ac\u201d Node/Express + TypeScript, layered routes\u00e2\u2020\u2019controllers\u00e2\u2020\u2019services\u00e2\u2020\u2019repositories, zod, Drizzle/Postgres. Hosts the F29 golden-path slice (PATCH /me bio).",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx watch --env-file=.env.dev src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -b && node scripts/build-prod.mjs",
    "start:prod": "node dist/server/index.js",
    "db:migrate:prod": "node dist/server/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-entry.ts",
    "db:backup": "tsx src/db/backup.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed-dev": "tsx src/dev/seed-dev.ts",
    "reflatten": "tsx --env-file=.env.dev scripts/reflatten.ts"
  },
  "dependencies": {
    "@expo-google-fonts/allerta-stencil": "^0.4.1",
    "@expo-google-fonts/bitter": "^0.4.1",
    "@expo-google-fonts/chakra-petch": "^0.4.1",
    "@expo-google-fonts/pacifico": "^0.4.1",
    "@expo-google-fonts/paytone-one": "^0.4.2",
    "@expo-google-fonts/press-start-2p": "^0.4.1",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@ingame/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^8.55.2",
    "@shopify/react-native-skia": "2.2.12",
    "compression": "^1.8.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.1",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "react": "19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.2"
  }
}
