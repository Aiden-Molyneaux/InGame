{
  "name": "@ingame/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "InGame API — Node/Express + TypeScript, layered routes→controllers→services→repositories, zod, Drizzle/Postgres. Hosts the F29 golden-path slice (PATCH /me bio).",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed-dev": "tsx src/dev/seed-dev.ts"
  },
  "dependencies": {
    "@ingame/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^8.55.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.1",
    "jose": "^5.10.0",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.2"
  }
}
