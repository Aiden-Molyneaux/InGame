{
  "name": "@ingame/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "InGame Expo/React Native client. M1: the Chrome (web) dev/test loop + iPhone path; the styled-profile slice + RTK Query binding land in M2.",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --passWithNoTests=false"
  },
  "dependencies": {
