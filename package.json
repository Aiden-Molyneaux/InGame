{
  "name": "ingame",
  "private": true,
  "version": "0.0.0",
  "description": "InGame — mobile-first game-collection showcase. M1 monorepo scaffold (the spine).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "stack": "node scripts/dev-stack.mjs",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p apps/mobile/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json",
    "build": "tsc -b tsconfig.json",
    "lint": "eslint . && npm run lint:custom && npm run lint:mobile",
    "lint:eslint": "eslint .",
    "lint:custom": "node tools/lint/run.mjs",
    "lint:mobile": "npm -w @ingame/mobile run lint",
    "lint:bundle": "node tools/security/bundle-grep.mjs",
    "spec:ids": "node tools/spec/build-id-registry.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:mobile": "npm -w @ingame/mobile run test",
    "test:admin": "npm -w @ingame/admin run test",
    "db:generate": "npm -w @ingame/api run db:generate",
    "db:migrate": "npm -w @ingame/api run db:migrate",
    "ci": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run lint:bundle && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.6",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react-native-worklets": "0.5.1"
  }
}
