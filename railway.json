{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm -w @ingame/api run build"
  },
  "deploy": {
    "preDeployCommand": "node apps/api/dist/server/migrate.js",
    "startCommand": "node --enable-source-maps apps/api/dist/server/index.js",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
